# Gunakan Node.js LTS dengan digest immutable.
FROM node:22@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914

# Set working directory
WORKDIR /app

# Salin package.json dan lock file
COPY package*.json ./

# Install dependencies
RUN npm ci

# Salin seluruh isi project
COPY . .

# Set environment variable untuk memastikan file watch berjalan dengan polling
ENV CHOKIDAR_USEPOLLING=true

# Port default untuk Vite dev server
EXPOSE 5173

# Jalankan dev server
# CMD ["npm", "run", "dev"]
CMD ["npm", "run", "dev", "--", "--host"]
